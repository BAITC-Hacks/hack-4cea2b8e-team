# Скопируйте в .env:  cp .env.example .env
# .env в .gitignore. Публиковать API-ключи в GitHub прямо запрещено
# инструкцией организаторов и правилами кибербезопасности хакатона.
#
# ВАЖНО (п. 5.6.6 Положения): проект обязан запускаться и демонстрировать
# основной сценарий БЕЗ личных аккаунтов участников. Поэтому при отсутствии
# ключа приложение само уходит в DEMO_MODE. Не удаляйте эту логику.
#
# ----------------------------------------------------------------------
# ОТКУДА БЕРЁТСЯ КЛЮЧ
# ----------------------------------------------------------------------
# Подписка ChatGPT Pro — инструмент разработки, API-доступа она НЕ даёт.
# Ключ для приложения берётся из одного из двух источников:
#
# 1) OpenAI API credits — командный промокод от организаторов.
#    Активируется по отдельной ссылке в OpenAI Platform,
#    проверяется в Billing → Promotions → Applied promotions.
#      OPENAI_API_KEY=sk-...
#      OPENAI_BASE_URL=https://api.openai.com/v1
#      MODEL=gpt-4o-mini
#
# 2) NVIDIA Build — ключ создаётся на build.nvidia.com/settings/api-keys.
#    Endpoint OpenAI-совместимый, код менять не нужно:
#      OPENAI_API_KEY=nvapi-...
#      OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#      MODEL=meta/llama-3.3-70b-instruct
#
# Держите второй вариант наготове: если упрётесь в лимит одного провайдера,
# переключение — три строки здесь, без правок кода.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# 1 — принудительный демо-режим (заглушки вместо вызовов модели)
DEMO_MODE=0

APP_NAME=HackAlem Starter
HOST=0.0.0.0
PORT=8000
DB_PATH=data/app.db
