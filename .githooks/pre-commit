#!/bin/sh
# Единственное, что этот хук блокирует, — утечка секретов.
# Всё остальное только предупреждает: на хакатоне хук, мешающий
# закоммитить в 17:55, опаснее кривого сообщения.
#
# Ставится через scripts/setup-git.sh

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0

# --- 1. Файлы, которых не должно быть в репозитории --------------------
for f in $staged; do
  case "$f" in
    .env|*/.env|*.pem|*.key|*/id_rsa)
      echo "СТОП: $f не должен попадать в репозиторий."
      fail=1
      ;;
    data/*|*/data/*)
      echo "Внимание: $f — локальные данные. Точно нужно в репозитории?"
      ;;
  esac
done

# --- 2. Похоже на ключ -------------------------------------------------
# Ищем только в добавляемых строках, чтобы не ругаться на старое.
leak=$(git diff --cached -U0 | grep -E '^\+' | \
       grep -E 'sk-[A-Za-z0-9_-]{16,}|nvapi-[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}' || true)

if [ -n "$leak" ]; then
  echo "СТОП: в изменениях похоже на API-ключ:"
  echo "$leak" | head -3 | cut -c1-100
  echo ""
  echo "Уберите ключ в .env и повторите. Если ключ уже утёк в историю —"
  echo "не чистите её, а отзовите ключ и выпустите новый: это быстрее и надёжнее."
  fail=1
fi

# --- 3. Мягкие напоминания --------------------------------------------
echo "$staged" | grep -q '^app/' && \
  echo "Напоминание: тронули бэкенд — прогоните pytest -q перед push."

if [ "$fail" = "1" ]; then
  echo ""
  echo "Коммит отменён. Обойти (только если уверены): git commit --no-verify"
  exit 1
fi

exit 0
